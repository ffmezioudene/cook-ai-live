cat << 'EOF' > .gitignore
# IDE and editors
.idea/
.vscode/

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Expo / React Native
.expo/
.expo-shared/
frontend/.metro-cache/

# Build outputs
/build
dist/

# Environment
.env
.env.*

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System
.DS_Store

# Python backend
__pycache__/
*.pyc
venv/
.venv/
EOF-e 
# Environment files
*.env
*.env.*
-e 
# Environment files
*.env
*.env.*
-e 
# Environment files
*.env
*.env.*
-e 
# Environment files
*.env
*.env.*
